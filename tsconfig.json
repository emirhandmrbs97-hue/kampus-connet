{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/components/*": ["./*"],
      "@/context/*": ["./*"],
      "@/lib/*": ["./*"],
      "@/services/*": ["./*"],
      "@/types": ["./types"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/**"
  ]
}
